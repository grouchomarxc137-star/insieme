# Channel DISCORD_TICKETS_WEBHOOK_URL posts into — needed (along with the bot
# token + guild id below) so the bot can create/reuse the "Ticket Archive"
# thread there when a ticket is closed. Leave unset to skip archiving (closed
# tickets just get their live message updated in place instead).
DISCORD_TICKETS_CHANNEL_ID=
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Channel for completed website Reset Room summaries.
DISCORD_CHANNEL_ID=
DISCORD_GUILD_ID=
DISCORD_PRINCIPE_USER_ID=
DISCORD_PRINCIPESSA_USER_ID=
# Optional local/staging database directory. Defaults to server/data; keep
# the existing Railway volume mount and default directory in production.
